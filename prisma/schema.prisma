// FWMS — مخطط قاعدة البيانات (SQLite + Prisma)
// ملكية: المساعد الثاني (تغييرات البنية عبر migrations فقط — راجع docs/DATABASE_GUIDE.md)
// قواعد نافذة: companyId في كل جدول تشغيلي | المال Int بالسنتيم | UTC في التخزين
// ملاحظة SQLite: لا enums — القيم النصية تُتحقق في طبقة التطبيق (src/lib/rbac.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// البنية المؤسسية (SPEC §3)
// ─────────────────────────────────────────────────────────────

/// كيان مالك المنصة (white-label) — ليس حسابًا شخصيًا (SPEC §3.2)
model PlatformOwner {
  id              String    @id @default(cuid())
  legalName       String
  displayName     String
  contactEmail    String?
  contactPhone    String?
  logoUrl         String?
  defaultLocale   String    @default("ar")
  defaultCurrency String    @default("MAD")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  companies Company[]
}

/// الشركة (المستأجر) — عزل البيانات عبر companyId في كل جدول تشغيلي
model Company {
  id              String   @id @default(cuid())
  platformOwnerId String?
  legalName       String
  tradeName       String?
  taxId           String? // ICE
  cnssNumber      String?
  locale          String   @default("ar")
  timezone        String   @default("Africa/Casablanca")
  currency        String   @default("MAD")
  status          String   @default("active") // active | suspended
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  platformOwner PlatformOwner?     @relation(fields: [platformOwnerId], references: [id])
  memberships   UserMembership[]
  grants        AccountantGrant[]
  settings      CompanySettings?
  payRules      PayRule[]
  verificationPolicies VerificationPolicy[]
  auditLogs     AuditLog[]
  branches      Branch[]
  projects      Project[]
  sites         Site[]
  workerGroups  WorkerGroup[]
  shiftTemplates ShiftTemplate[]
  shifts        Shift[]
  shiftRecurrences ShiftRecurrence[]
  attendanceEvents AttendanceEvent[]

  @@index([status])
}

/// هوية المستخدم الواحدة — العلاقة بالشركات عبر العضويات فقط (SPEC §3.1)
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  phone                 String?
  fullName              String
  passwordHash          String
  isActive              Boolean   @default(true)
  twoFactorEnabled      Boolean   @default(false)
  locale                String    @default("ar")
  lastLoginAt           DateTime?
  sessionsInvalidatedAt DateTime? // إبطال كل جلسات صدرت قبله (خروج فعلي/تدوير أمان)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships  UserMembership[]
  grants       AccountantGrant[]
  auditActions AuditLog[]
  workerShifts      Shift[] @relation("ShiftWorker")
  workerRecurrences ShiftRecurrence[] @relation("RecurrenceWorker")
  attendanceEvents AttendanceEvent[] @relation("AttendanceWorker")

  @@index([isActive])
}

/// عضوية المستخدم في شركة بدور واحد (SPEC §3.1) — الجلسة تعمل بشركة نشطة واحدة
model UserMembership {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  role      String // super_admin | accountant | admin | co_admin | employee
  scopeJson String? // نطاق co_admin: JSON نصي لمجموعات/مواقع مسندة
  isDefault Boolean   @default(false)
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId, role])
}

/// منح المحاسب الخارجي — صريحة، مؤقتة، قابلة للسحب (SPEC §3.3)
model AccountantGrant {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  mode      String    @default("external") // internal | external
  grantedBy String
  startsAt  DateTime
  endsAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, userId])
}

// ─────────────────────────────────────────────────────────────
// البنية التنظيمية والمواقع (SPEC §5 و§8 — المرحلة 2)
// الأرشفة بدل الحذف (status=archived) حفاظًا على سلامة المراجع (SPEC §11.7)
// ─────────────────────────────────────────────────────────────

/// فرع الشركة (SPEC §5: branches) — يضم مشاريع ومواقع
model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String?
  city      String?
  address   String?
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  projects Project[]
  sites    Site[]

  @@index([companyId, status])
}

/// مشروع/عقد داخل الشركة (SPEC §5: projects) — يُسنَد له مواقع
model Project {
  id        String    @id @default(cuid())
  companyId String
  branchId  String?
  name      String
  code      String?
  status    String    @default("active") // active | archived
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  branch  Branch?  @relation(fields: [branchId], references: [id])
  sites   Site[]

  @@index([companyId, status])
  @@index([companyId, branchId])
}

/// موقع العمل: نقطة مركز + نصف قطر للتحقق الجغرافي (SPEC §4.2 و§5: sites)
/// latitude/longitude عشرية Float — نطاقها يُتحقق في طبقة التطبيق (zod)؛ SQLite بلا PostGIS
model Site {
  id        String   @id @default(cuid())
  companyId String
  branchId  String?
  projectId String?
  name      String
  address   String?
  latitude  Float // [-90, 90]
  longitude Float // [-180, 180]
  radiusM   Int      @default(50) // نصف قطر التحقق بالمتر (SPEC §4.2: افتراضي 50 م)
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id])
  branch              Branch?              @relation(fields: [branchId], references: [id])
  project             Project?             @relation(fields: [projectId], references: [id])
  verificationPolicies VerificationPolicy[]
  shifts             Shift[]
  shiftRecurrences   ShiftRecurrence[]
  attendanceEvents   AttendanceEvent[]

  @@index([companyId, status])
  @@index([companyId, branchId])
  @@index([companyId, projectId])
}

/// مجموعة عمال (SPEC §5: worker_groups) — تُستخدم في الجدولة والتغطية (المرحلة 3+)
model WorkerGroup {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
}

// ─────────────────────────────────────────────────────────────
// الجدولة (SPEC §4.1 و§8 — المرحلة 3)
// التخزين UTC (startsAt/endsAt) لمنع التعارض بالفترات؛ localDate = يوم البداية بتوقيت الشركة
// الأرشفة/الإلغاء بدل الحذف (SPEC §11.7) — سجلات الجدولة تُغذي الحضور والأجور لاحقاً
// ─────────────────────────────────────────────────────────────

/// قالب وردية بحسب القطاع (SPEC §4.1): حراسة (ليل متصل)، بناء (نهار محدد)، نظافة (توزيع متعدد)
/// startTimeMin/endTimeMin = دقائق من منتصف الليل بتوقيت الشركة؛ endTime ≤ start = وردية تعبر منتصف الليل
model ShiftTemplate {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  sector       String   @default("other") // security | construction | cleaning | gardening | crafts | other
  startTimeMin Int // 0..1439
  endTimeMin   Int // 0..1439
  breakMinutes Int      @default(0)
  notes        String?
  status       String   @default("active") // active | archived
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  shifts      Shift[]
  recurrences ShiftRecurrence[]

  @@index([companyId, status])
  @@index([companyId, sector])
}

/// وردية مجدولة (إسناد عامل لموقع بوقت محدد) — وحدة منع التعارض: عامل في موقعين بنفس الوقت ممنوع (SPEC §4.1)
model Shift {
  id              String    @id @default(cuid())
  companyId       String
  workerUserId    String
  siteId          String
  templateId      String?
  recurrenceId    String?
  localDate       String // "YYYY-MM-DD" بتوقيت الشركة (يوم بداية الوردية)
  startsAt        DateTime // UTC
  endsAt          DateTime // UTC — قد تعبر منتصف الليل (SPEC §11.4: وردية 22:00–06:00)
  breakMinutes    Int       @default(0)
  status          String    @default("scheduled") // scheduled | cancelled
  source          String    @default("manual") // manual | recurrence | rotation
  notes           String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    Company          @relation(fields: [companyId], references: [id])
  worker     User             @relation("ShiftWorker", fields: [workerUserId], references: [id])
  site       Site             @relation(fields: [siteId], references: [id])
  template   ShiftTemplate?   @relation(fields: [templateId], references: [id])
  recurrence ShiftRecurrence? @relation(fields: [recurrenceId], references: [id])
  attendanceEvents AttendanceEvent[]

  @@index([companyId, workerUserId, startsAt])
  @@index([companyId, siteId, startsAt])
  @@index([companyId, status, startsAt])
  @@index([recurrenceId])
}

/// قاعدة ورديات متكررة (fixed: قالب ثابت بأيام أسبوع) أو متناوبة (rotating: دورة قوالب مرتبة) — SPEC §4.1
model ShiftRecurrence {
  id               String   @id @default(cuid())
  companyId        String
  workerUserId     String
  siteId           String
  mode             String   @default("fixed") // fixed | rotating
  templateId       String? // للنمط fixed
  rotationJson     String? // للنمط rotating: JSON مصفوفة معرفات قوالب بالترتيب
  rotationStepDays Int      @default(7) // أيام لكل خطوة في الدورة
  weekdaysJson     String? // للنمط fixed: JSON [0..6] (0=الأحد)
  startsOn         String // "YYYY-MM-DD"
  endsOn           String?
  status           String   @default("active") // active | archived
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id])
  worker   User           @relation("RecurrenceWorker", fields: [workerUserId], references: [id])
  site     Site           @relation(fields: [siteId], references: [id])
  template ShiftTemplate? @relation(fields: [templateId], references: [id])
  shifts   Shift[]

  @@index([companyId, status])
  @@index([companyId, workerUserId])
}

// ─────────────────────────────────────────────────────────────
// الحضور والتحقق الجغرافي (SPEC §4.2 و§8 — المرحلة 4)
// append-only: سجلات الحضور لا تُحذف أبدًا (SPEC §11.7) — الرفض يُسجَّل أيضًا كمحاولة
// التخزين UTC (occurredAt وقت العميل، recordedAt وقت الخادم الفاصل)؛ المسافة تُحسب في الخادم حصرًا
// ─────────────────────────────────────────────────────────────

/// حدث حضور/انصراف واحد (check_in | check_out) — القلب: تحقق خادمي بالنطاق الجغرافي + مكافحة التلاعب + سياسة التحقق
model AttendanceEvent {
  id               String    @id @default(cuid())
  companyId        String
  workerUserId     String
  siteId           String
  shiftId          String? // الوردية المرتبطة إن وُجدت مطابقة زمنية
  type             String // check_in | check_out
  occurredAt       DateTime // وقت العميل المُبلَّغ (UTC)
  recordedAt       DateTime @default(now()) // وقت الخادم الفاصل (UTC) — المرجع
  latitude         Float // [-90, 90]
  longitude        Float // [-180, 180]
  accuracyM        Float? // دقة GPS المُبلَّغة بالمتر
  distanceM        Float? // المسافة من مركز الموقع (Haversine) — محسوبة في الخادم
  insideFence      Boolean // داخل نصف قطر الموقع؟
  policy           String    @default("none") // السياسة المطلوبة وقت التسجيل: none|qr|face|qr_and_face|qr_or_face
  verification     String    @default("none") // ما تحقق فعلاً لنفس الأنماط
  qrNonce          String?   @unique // nonce من رمز QR المستخدم — منع إعادة الاستخدام (SPEC §4.2)
  status           String    @default("verified") // verified | pending_review | rejected
  reason           String? // outside_fence|poor_accuracy|mock_location|impossible_jump|qr_missing|qr_invalid|face_missing|face_failed|review_rejected
  deviceJson       String? // بصمة الجهاز المُبلَّغة (platform/mockLocation/rooted/emulator) — بلا معرّفات حساسة
  spoofJson        String? // نتيجة فحوص مكافحة التلاعب في الخادم (JSON نصي)
  networkMode      String    @default("internet") // lan | internet — للعرض فقط؛ القواعد واحدة في الوضعين (SPEC §4.2)
  reviewNotes      String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company           @relation(fields: [companyId], references: [id])
  worker  User             @relation("AttendanceWorker", fields: [workerUserId], references: [id])
  site    Site             @relation(fields: [siteId], references: [id])
  shift   Shift?           @relation(fields: [shiftId], references: [id])

  @@index([companyId, workerUserId, occurredAt])
  @@index([companyId, siteId, occurredAt])
  @@index([companyId, status, occurredAt])
  @@index([type, occurredAt])
}

// ─────────────────────────────────────────────────────────────
// الإعدادات والسياسات
// ─────────────────────────────────────────────────────────────

/// إعدادات الشركة (SPEC §11): قيم العمل بقيم افتراضية مغربية
model CompanySettings {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  workWeekHours       Int      @default(44)
  restDay             Int      @default(5) // 0=الأحد … 5=الجمعة
  monthlyHoursDivisor Int      @default(191)
  overtimeCapAnnual   Int? // اختياري (SPEC §11.4)
  showWagesToSupervisor Boolean @default(false)
  dualApprovalEnabled Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

/// سياسة التحقق من الهوية عند الحضور (SPEC §4.2) — على مستوى الشركة (والموقع لاحقًا)
model VerificationPolicy {
  id               String   @id @default(cuid())
  companyId        String? // null = مستوى المنصة
  siteId           String? // مستوى الموقع (المرحلة 2+)
  policy           String   @default("none") // none | qr | face | qr_and_face | qr_or_face
  faceAcknowledged Boolean  @default(false) // إقرار المالك القانوني لتفعيل face
  updatedAt        DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
  site    Site?    @relation(fields: [siteId], references: [id])

  @@unique([companyId, siteId])
}

// ─────────────────────────────────────────────────────────────
// قواعد الأجور (SPEC §11) — بيانات بتواريخ سريان، لا ثوابت كود
// ─────────────────────────────────────────────────────────────

/// سطر قاعدة أجر واحد:companyId=null يعني مستوى المنصة
model PayRule {
  id            String    @id @default(cuid())
  companyId     String?
  key           String // مثال: smig.hourly | cnss.employee.short | ir.brackets
  valueInt      Int? // بالسنتيم أو بنقاط الأساس x10000
  valueText     String? // للقيم غير الرقمية (JSON الشرائح، الأوقات)
  unit          String    @default("cents") // cents | basis_points | text | hours
  effectiveFrom DateTime
  source        String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, key, effectiveFrom])
  @@index([key, effectiveFrom])
}

// ─────────────────────────────────────────────────────────────
// سجل التدقيق (SPEC §3 و§6) — append-only
// ─────────────────────────────────────────────────────────────

/// كل فعل حساس: من، متى، ماذا، قبل/بعد، السبب
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String? // null = حدث على مستوى المنصة
  userId     String? // الفاعل (null = نظام)
  action     String // auth.login | company.switch | user.create | ...
  entity     String?
  entityId   String?
  beforeJson String? // JSON نصي
  afterJson  String? // JSON نصي
  reason     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}
